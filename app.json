{
  "expo": {
    "name": "Gachi Gochi",
    "slug": "gachi-gochi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gachigochi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gachigochi.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "걸음 수와 이동 거리를 읽어 걷기 보상(귤·XP)을 지급하려면 건강 데이터 접근이 필요해요.",
        "NSHealthUpdateUsageDescription": "가치고치는 건강 앱에 데이터를 쓰지 않아요."
      }
    },
    "android": {
      "package": "com.gachigochi.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "쓰레기를 촬영해 봉그깅을 인증할 수 있게 카메라 접근을 허용해 주세요.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "갤러리에서 쓰레기 사진을 고를 수 있게 사진 접근을 허용해 주세요.",
          "cameraPermission": "쓰레기를 촬영해 봉그깅을 인증할 수 있게 카메라 접근을 허용해 주세요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "쓰레기 인증에 촬영 장소를 함께 남기려면 위치 접근을 허용해 주세요.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "걸음 수와 이동 거리를 읽어 걷기 보상(귤·XP)을 지급하려면 건강 데이터 접근이 필요해요.",
          "NSHealthUpdateUsageDescription": "가치고치는 건강 앱에 데이터를 쓰지 않아요.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
