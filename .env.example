# Copy this file to .env and fill in the values.
# Only EXPO_PUBLIC_ variables are included in the app bundle.
# Do not commit .env.
EXPO_PUBLIC_API_URL=

# 쓰레기 사진 판별에 쓰는 Gemini API 키 (aistudio.google.com → Get API key).
# EXPO_PUBLIC_ 값은 앱 파일에 그대로 들어가서 누구나 꺼낼 수 있다. 테스트용으로만 쓴다.
EXPO_PUBLIC_GEMINI_API_KEY=
